    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Parse Gemini output\nconst geminiRaw = item.content.parts[0].text\n  .replace(/```json\\n/g, '')\n  .replace(/```/g, '')\n  .trim();\nconst gemini = JSON.parse(geminiRaw);\n\n// Parse OpenAI output\nconst openaiRaw = item.output[0].content[0].text;\nconst openai = JSON.parse(openaiRaw);\n\nreturn {\n  resume_check: {\n    is_valid_resume: gemini.is_valid_resume,\n    confidence: gemini.confidence,\n    invalid_reason: gemini.invalid_reason,\n    candidate_name: gemini.candidate_name,\n    resume_rating: gemini.resume_rating,\n    rating_breakdown: gemini.rating_breakdown,\n    summary: gemini.summary,\n    key_skills_detected: gemini.key_skills_detected,\n    years_of_experience: gemini.years_of_experience,\n    education_detected: gemini.education_detected,\n    red_flags: gemini.red_flags\n  },\n  lead_scoring: {\n    lead_score: openai.lead_score,\n    score_breakdown: openai.score_breakdown,\n    summary: openai.summary,\n    green_flags: openai.green_flags,\n    red_flags: openai.red_flags,\n    recommendation: openai.recommendation\n  }\n};"
      },
